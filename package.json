{
  "name": "agitsh",
  "version": "0.5.0",
  "description": "git for running agents — import, inspect, verify, and replay AI coding sessions as an open, hash-chained event log",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agitHQ/agit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agit": "dist/cli.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "PROTOCOL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "session",
    "replay",
    "audit",
    "jsonl"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
